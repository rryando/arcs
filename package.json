{
  "name": "@rryando/arcs",
  "version": "4.2.0",
  "description": "ARCS — DAG-based task orchestration for AI agents. Persistent workflow continuity via graph-structured context.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "arcs": "scripts/arcs-cli.mjs"
  },
  "files": [
    "dist/",
    "scripts/",
    "templates/",
    "skills/",
    "opencode/"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rryando/arcs.git"
  },
  "keywords": [
    "arcs",
    "dag",
    "ai-agents",
    "task-orchestration",
    "graph",
    "workflow",
    "cli"
  ],
  "author": "rryando",
  "license": "MIT",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "tsc",
    "build:opencode-bundle": "npm run build && node scripts/build-opencode-bundle.mjs",
    "build:web": "npm --workspace @arcs/web run build",
    "prepack": "npm run build:opencode-bundle && npm run build:web",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "init": "node dist/index.js init",
    "lint": "biome check src/ test/ web/",
    "lint:fix": "biome check --fix src/ test/ web/",
    "format": "biome format --write src/ test/ web/",
    "typecheck": "tsc --noEmit",
    "web:server": "npm run build && npm run build:web && node dist/index.js web",
    "web:dev": "npm --workspace @arcs/web run dev"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@hono/node-server": "^2.0.12",
    "@rryando/arcs": "^3.9.1",
    "hono": "^4.12.32",
    "picocolors": "^1.1.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/bun": "latest",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
