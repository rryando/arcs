{
  "bundleId": "arcs-opencode-bundle",
  "installMode": "opencode-arcs",
  "bundleVersionSource": "package.json",
  "sourceRoot": "opencode/arcs",
  "skills": {
    "source": "skills",
    "destination": "skills/arcs"
  },
  "agents": [
    { "source": "prompts/software-engineer.txt", "destination": "prompts/software-engineer.txt" },
    { "source": "prompts/tech-architect.txt", "destination": "prompts/tech-architect.txt" },
    { "source": "prompts/oncall-ops.txt", "destination": "prompts/oncall-ops.txt" },
    { "source": "prompts/arcs-docs.txt", "destination": "prompts/arcs-docs.txt" },
    { "source": "prompts/code-reviewer.txt", "destination": "prompts/code-reviewer.txt" },
    { "source": "prompts/docs-researcher.txt", "destination": "prompts/docs-researcher.txt" },
    { "source": "prompts/devil-advocate.txt", "destination": "prompts/devil-advocate.txt" },
    { "source": "prompts/graph-explorer.txt", "destination": "prompts/graph-explorer.txt" },
    { "source": "prompts/arcs-orchestrate.txt", "destination": "prompts/arcs-orchestrate.txt" },
    { "source": "prompts/arcs-orchestrate-caveman.txt", "destination": "prompts/arcs-orchestrate-caveman.txt" }
  ],
  "ownedPaths": [
    "skills/arcs",
    "plugins/arcs.js"
  ],
  "plugin": {
    "required": true,
    "source": ".opencode/plugins/arcs.js",
    "destination": "plugins/arcs.js"
  },
  "config": {
    "requiredMerges": [
      {
        "path": [
          "permission"
        ],
        "value": {
          "external_directory": {
            "/tmp": "allow",
            "/tmp/**": "allow",
            "~/.arcs": "allow",
            "~/.arcs/**": "allow",
            "~/.config/opencode": "allow",
            "~/.config/opencode/**": "allow"
          }
        },
        "mode": "merge"
      },
      {
        "path": [
          "lsp"
        ],
        "value": true,
        "mode": "if-absent"
      },
      {
        "path": [
          "model"
        ],
        "value": "github-copilot/claude-sonnet-4.6",
        "mode": "if-absent"
      },
      {
        "path": [
          "agent",
          "build",
          "model"
        ],
        "value": "github-copilot/claude-sonnet-4.6",
        "mode": "if-absent"
      },
      {
        "path": [
          "agent",
          "build",
          "temperature"
        ],
        "value": 0,
        "mode": "if-absent"
      },
      {
        "path": [
          "agent",
          "plan",
          "model"
        ],
        "value": "github-copilot/claude-opus-4.6",
        "mode": "if-absent"
      },
      {
        "path": [
          "agent",
          "plan",
          "temperature"
        ],
        "value": 0.5,
        "mode": "if-absent"
      },
      {
        "path": [
          "agent",
          "general",
          "model"
        ],
        "value": "github-copilot/claude-opus-4.6",
        "mode": "if-absent"
      },
      {
        "path": [
          "agent",
          "general",
          "temperature"
        ],
        "value": 0.3,
        "mode": "if-absent"
      },
      {
        "path": [
          "agent",
          "graph-explorer"
        ],
        "value": {
          "description": "DAG-first codebase and knowledge exploration specialist. Queries arcs search, related, and context first, then codegraph MCP code-intelligence tools, before falling back to raw file-system tools. Replaces vanilla explore for ARCS projects.",
          "mode": "subagent",
          "model": "github-copilot/claude-haiku-4.5",
          "temperature": 0,
          "permission": {
            "edit": "deny",
            "bash": "allow",
            "webfetch": "allow",
            "mcp": "allow",
            "external_directory": { "*": "allow" }
          },
          "prompt": "{file:./prompts/graph-explorer.txt}"
        },
        "mode": "merge"
      },
      {
        "path": [
          "agent",
          "code-reviewer"
        ],
        "value": {
          "description": "Reviews code changes for production readiness and catches correctness, maintainability, and testing issues.",
          "mode": "subagent",
          "model": "github-copilot/claude-haiku-4.5",
          "temperature": 0.5,
          "prompt": "{file:./prompts/code-reviewer.txt}",
          "permission": {
            "edit": "deny",
            "bash": "allow",
            "webfetch": "allow",
            "mcp": "allow",
            "external_directory": { "*": "allow" }
          }
        },
        "mode": "merge"
      },
      {
        "path": [
          "agent",
          "docs-researcher"
        ],
        "value": {
          "description": "Handles documentation writing, research synthesis, OCR-adjacent extraction, and document-heavy analysis tasks.",
          "mode": "subagent",
          "model": "github-copilot/claude-opus-4.6",
          "temperature": 0.4,
          "permission": {
            "edit": "allow",
            "bash": "allow",
            "webfetch": "allow",
            "mcp": "allow",
            "external_directory": { "*": "allow" }
          },
          "prompt": "{file:./prompts/docs-researcher.txt}"
        },
        "mode": "merge"
      },
      {
        "path": [
          "agent",
          "tech-architect"
        ],
        "value": {
          "description": "Architecture and analysis specialist. Deep structural reasoning, refactor guidance, trade-off evaluation, and root cause analysis without making hasty edits.",
          "mode": "subagent",
          "model": "github-copilot/claude-haiku-4.5",
          "temperature": 0.4,
          "permission": {
            "edit": "deny",
            "bash": "allow",
            "webfetch": "allow",
            "mcp": "allow",
            "external_directory": { "*": "allow" }
          },
          "prompt": "{file:./prompts/tech-architect.txt}"
        },
        "mode": "merge"
      },
      {
        "path": [
          "agent",
          "software-engineer"
        ],
        "value": {
          "description": "Implementation specialist. Writes code, runs tests, ships features. Loads quick-dev, code-agent, test-driven-development, and executing-plans skills as needed.",
          "mode": "subagent",
          "model": "github-copilot/claude-opus-4.6",
          "temperature": 0,
          "permission": {
            "edit": "allow",
            "bash": "allow",
            "webfetch": "allow",
            "mcp": "allow",
            "external_directory": { "*": "allow" }
          },
          "prompt": "{file:./prompts/software-engineer.txt}"
        },
        "mode": "merge"
      },
      {
        "path": [
          "agent",
          "arcs-docs"
        ],
        "value": {
          "description": "ARCS documentation specialist. Manages plans, knowledge entries, diagrams, and DAG health. Knows ARCS structure intimately.",
          "mode": "subagent",
          "model": "github-copilot/claude-opus-4.6",
          "temperature": 0.1,
          "permission": {
            "edit": "allow",
            "bash": "allow",
            "webfetch": "allow",
            "mcp": "allow",
            "external_directory": { "*": "allow" }
          },
          "prompt": "{file:./prompts/arcs-docs.txt}"
        },
        "mode": "merge"
      },
      {
        "path": [
          "agent",
          "devil-advocate"
        ],
        "value": {
          "description": "Adversarial phase-gate agent. Checks work at phase boundaries using KISS/YAGNI/DRY principles. Runs tests, reads diffs, delivers pass/block verdicts. Cannot edit code.",
          "mode": "subagent",
          "model": "github-copilot/claude-sonnet-4.6",
          "temperature": 0.7,
          "permission": {
            "edit": "deny",
            "bash": "allow",
            "webfetch": "allow",
            "mcp": "allow",
            "external_directory": { "*": "allow" }
          },
          "prompt": "{file:./prompts/devil-advocate.txt}"
        },
        "mode": "merge"
      },
      {
        "path": [
          "agent",
          "devil-advocate",
          "permission",
          "edit"
        ],
        "value": "deny",
        "mode": "overwrite"
      },
      {
        "path": [
          "agent",
          "oncall-ops"
        ],
        "value": {
          "description": "Debugging and diagnosis specialist. Finds root causes through systematic investigation, log triage, bisect, and performance profiling.",
          "mode": "subagent",
          "model": "github-copilot/claude-opus-4.6",
          "temperature": 0.1,
          "permission": {
            "edit": "allow",
            "bash": "allow",
            "webfetch": "allow",
            "mcp": "allow",
            "external_directory": { "*": "allow" }
          },
          "prompt": "{file:./prompts/oncall-ops.txt}"
        },
        "mode": "merge"
      },
      {
        "path": [
          "small_model"
        ],
        "value": "github-copilot/claude-haiku-4.5",
        "mode": "if-absent"
      },
      {
        "path": [
          "agent",
          "graph-explorer",
          "permission",
          "edit"
        ],
        "value": "deny",
        "mode": "overwrite"
      },
      {
        "path": [
          "agent",
          "code-reviewer",
          "permission",
          "edit"
        ],
        "value": "deny",
        "mode": "overwrite"
      },
      {
        "path": [
          "agent",
          "tech-architect",
          "permission",
          "edit"
        ],
        "value": "deny",
        "mode": "overwrite"
      }
    ]
  }
}
